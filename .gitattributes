*.ptx -text whitespace=-blank-at-eof,cr-at-eol

*.exe binary
*.dll binary
*.lib binary
*.pdb binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.tif binary
*.tiff binary
*.icm binary
*.icc binary
*.fcrv binary
*.cocatalogdb binary
